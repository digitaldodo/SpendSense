NEXT_PUBLIC_ANALYTICS_WRITE_KEY=

SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://your-supabase-host:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-managed-database-password
