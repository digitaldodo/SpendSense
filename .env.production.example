NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://app.spendsense.example
NEXT_PUBLIC_API_BASE_URL=https://api.spendsense.example
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-managed-supabase-anon-key
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_VERSION=0.1.0

SPRING_PROFILES_ACTIVE=production
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://your-supabase-host:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-managed-database-password
PUBLIC_BASE_URL=https://api.spendsense.example
WEB_ORIGIN=https://app.spendsense.example
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URI=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
SPENDSENSE_RATE_LIMIT_ENABLED=true
SPENDSENSE_WEBHOOK_REQUIRE_SIGNATURE=true
RESEND_WEBHOOK_SECRET=your-managed-resend-webhook-secret
SMTP_FALLBACK_WEBHOOK_SECRET=your-managed-smtp-fallback-secret
PUSH_PROVIDER_WEBHOOK_SECRET=your-managed-push-provider-secret
RESEND_ENABLED=false
RESEND_API_KEY=
