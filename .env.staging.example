NEXT_PUBLIC_APP_ENV=staging
NEXT_PUBLIC_SITE_URL=https://staging.spendsense.example
NEXT_PUBLIC_API_BASE_URL=https://api-staging.spendsense.example
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-managed-staging-supabase-anon-key
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_VERSION=0.1.0-staging
NEXT_PUBLIC_RELEASE_COMMIT=managed-git-sha
NEXT_PUBLIC_MAINTENANCE_MODE=0
NEXT_PUBLIC_DEGRADED_MODE=0
NEXT_PUBLIC_FEATURE_FLAGS={}
NEXT_PUBLIC_ANALYTICS_WRITE_KEY=

SPRING_PROFILES_ACTIVE=staging
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://your-staging-supabase-host:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-managed-staging-database-password
PUBLIC_BASE_URL=https://api-staging.spendsense.example
WEB_ORIGIN=https://staging.spendsense.example
SUPABASE_JWT_ISSUER=https://your-staging-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URI=https://your-staging-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
SPENDSENSE_ENVIRONMENT=staging
SPENDSENSE_RELEASE_VERSION=0.1.0-staging
SPENDSENSE_RELEASE_COMMIT=managed-git-sha
SPENDSENSE_MAINTENANCE_MODE=false
SPENDSENSE_DEGRADED_MODE=false
SPENDSENSE_FEATURE_FLAGS={}
SPENDSENSE_ALERT_ESCALATION_EMAIL=ops-staging@example.com
SPENDSENSE_RATE_LIMIT_ENABLED=true
SPENDSENSE_WEBHOOK_REQUIRE_SIGNATURE=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
RESEND_ENABLED=false
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=your-managed-staging-resend-webhook-secret
SMTP_FALLBACK_WEBHOOK_SECRET=your-managed-staging-smtp-fallback-secret
PUSH_PROVIDER_WEBHOOK_SECRET=your-managed-staging-push-provider-secret
